<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12, which has no system splash API: the
     theme's ground colour with the Agonez emblem at the same size and place
     as the Android 12+ splash and the Flutter boot screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_emblem"
        android:gravity="center" />
</layer-list>
