server {
  listen 8080;
  listen [::]:8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  charset utf-8;
  server_tokens off;
  client_max_body_size 2m;

  # Resolve the API container through Docker's embedded DNS on every request.
  # A literal hostname in proxy_pass is resolved once at startup and cached
  # forever, so a backend-only redeploy (new container, new IP) would leave
  # nginx calling a dead address until the frontend was restarted too.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream "${API_UPSTREAM}";

  gzip on;
  gzip_types text/plain text/css application/json application/javascript image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;

  location ^~ /api/ {
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /media/ {
    proxy_pass http://$api_upstream;
    proxy_set_header Host $host;
  }

  # Vite also emits its compiled JS/CSS under /assets. Only the canonical
  # anatomy document belongs to FastAPI; all other /assets files stay local.
  location = /assets/anatomy.svg {
    proxy_pass http://$api_upstream;
    proxy_set_header Host $host;
  }

  location ^~ /health/ {
    proxy_pass http://$api_upstream;
    proxy_set_header Host $host;
  }

  location = /openapi.json {
    proxy_pass http://$api_upstream/openapi.json;
    proxy_set_header Host $host;
  }

  location ^~ /docs {
    proxy_pass http://$api_upstream;
    proxy_set_header Host $host;
  }

  location ~* \.(?:js|css|woff2|png|jpg|jpeg|webp|avif|svg)$ {
    try_files $uri =404;
    expires 7d;
    # nginx does not inherit server-level add_header directives when a
    # location defines any add_header of its own.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Cache-Control "public, max-age=604800, immutable";
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Cache-Control "no-cache";
  }
}
